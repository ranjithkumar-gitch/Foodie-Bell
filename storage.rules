rules_version = '2';

// Demo/prototype rules, same gate as firestore.rules: any signed-in
// QuickMandi user can read/write vendor document uploads. No server-side
// custom-claims role check (would need Cloud Functions/Admin SDK, out of
// scope for this mock-data-plus-real-auth build) — good enough to keep out
// anonymous/third-party traffic without blocking the app itself.
service firebase.storage {
  match /b/{bucket}/o {
    match /vendor_documents/{vendorId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /driver_documents/{driverId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /user_avatars/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /manager_avatars/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /promotion_images/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /product_images/{vendorId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /global_product_images/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /list_order_images/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /list_order_receipts/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
