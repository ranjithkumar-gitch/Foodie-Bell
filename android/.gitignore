# The Gradle wrapper (gradlew, gradlew.bat, gradle/wrapper/*) is tracked on
# purpose, so every developer builds with the same Gradle (Phase I.8).
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Phase I.8: build output, IDE and machine files (never committed).
/build/
/app/build/
/app/debug
/app/profile
/app/release
.kotlin/
*.iml
.idea/
.DS_Store
# Signing material and its settings, wherever they sit under android/.
**/key.properties
**/*.p12
**/*.pem
