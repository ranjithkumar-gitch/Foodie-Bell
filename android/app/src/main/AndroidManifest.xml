<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location while the app is open: pinning a delivery address, nearby
         shops and delivery times, a shop pinning its location, a driver's
         position on the delivery map. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- UCropActivity below is locked to portrait, which makes Play assume
         the app *requires* a portrait screen and hide it from devices
         without one (some tablets, Chromebooks). Portrait is preferred,
         not required. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <!-- No background location (2026-11-20): live driver tracking is parked
         (`driver_location_tracker.dart` isn't started), so the
         FOREGROUND_SERVICE_LOCATION permission is gone — Play requires a
         declaration and video for it — and the geolocator plugin's location
         service is removed below. Put both back with the tracking. -->
    <application
        android:label="QuickMandi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Occasion-driven home-screen icon (`app_icon_channel.dart`,
             `MainActivity.kt`): no bundled alternate icons right now (the
             old festiveGold/festiveRed/Dasara assets were removed along
             with the app icon refresh) — `MainActivity.kt`'s alias map is
             empty to match, so `setAppIcon` calls harmlessly no-op instead
             of pointing at a component that doesn't exist here anymore.
             When a new occasion icon is generated (`generate_occasion_icons.py`),
             add its `<activity-alias>` back here (same shape as these used
             to be: targetActivity=".MainActivity", starts disabled, its own
             MAIN/LAUNCHER intent-filter) and its entry back into that map. -->
        <!-- FCM's automatic system-tray display (background/terminated,
             `fcm_topics.dart`) uses this as the small status-bar icon
             instead of a generic bell/warning glyph when none is set. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- `image_cropper`'s Android implementation (the Yalantis uCrop
             library) needs this activity declared by the *app* — its own
             plugin manifest doesn't include it. Without this, launching the
             crop screen (Vendor document uploads, product photo picker)
             throws ActivityNotFoundException and takes the whole app down. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Google Maps SDK key for the User's live order tracking map
             (`driver_live_map.dart`). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBVE7vsYfkVURXi8UTjXDyNoE_EBPOvdcQ" />
        <!-- The geolocator plugin's background location service: unused
             while driver tracking is parked (see the permissions above). -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- `url_launcher`'s `tel:` scheme (Driver "call customer" /
             User "call driver") needs this declared here on Android 11+
             package-visibility rules, or launchUrl silently fails to find
             the dialer. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
